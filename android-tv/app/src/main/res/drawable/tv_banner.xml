<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 launcher banner: MyQ mark on the app's navy gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:centerColor="#122457"
                android:endColor="#080F26"
                android:startColor="#2C5AB8"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_myq_logo"
        android:gravity="center"
        android:height="86dp"
        android:width="86dp" />
</layer-list>
